<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ConcreteFactory" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/toolbar_bg</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/concrete_900</item>
        <item name="colorOnBackground">@color/concrete_900</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="materialButtonStyle">@style/Widget.ConcreteFactory.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ConcreteFactory.Dialog</item>
        <!-- These were the actual source of the "دیده نمی‌شود" complaints: with none of them
             set explicitly, every SYSTEM-rendered surface that isn't one of our own XML
             TextViews (Toolbar overflow/options menu, Spinner/AutoCompleteTextView popups,
             MaterialAlertDialogBuilder .setItems() lists, and the EditText/TextInputLayout
             caret + focus underline) fell back to whatever Material's un-overridden default
             happened to resolve to, which isn't guaranteed to invert correctly between our two
             themes just because the parent is DayNight. Pointing them at colors that ARE
             correctly overridden per-theme (concrete_900/concrete_500 in values-night) fixes
             every one of those surfaces at once instead of patching each screen individually. -->
        <item name="android:textColorPrimary">@color/concrete_900</item>
        <item name="android:textColorSecondary">@color/concrete_500</item>
        <item name="android:textColorHint">@color/concrete_500</item>
        <item name="colorControlNormal">@color/concrete_500</item>
        <item name="colorControlActivated">@color/safety_amber</item>
        <item name="colorControlHighlight">@color/concrete_300</item>
    </style>

    <!-- Dialog buttons (ثبت/انصراف on every confirm dialog, including "ثبت راننده جدید") default
         to using colorPrimary as their text color. In dark mode colorPrimary (toolbar_bg,
         #1F2429) is nearly the same shade as the dialog's own dark surface, so the buttons were
         basically invisible. Forcing android:textColor directly on the button style — instead of
         only overriding colorPrimary and hoping it's inherited correctly — is the more reliable
         fix: it can't be re-overridden by some other theme attribute further down the chain.
         colorSurface/colorOnSurface/textColorPrimary are set here too, for the same reason as
         the main theme above — a MaterialAlertDialogBuilder .setItems() list (used for the
         machinery cargo-type picker, for one) renders its rows using THIS overlay's roles, not
         the Activity theme's, so without these the list itself — not just its buttons — was
         unreadable in dark mode. -->
    <style name="ThemeOverlay.ConcreteFactory.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/safety_amber_dark</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/concrete_900</item>
        <item name="android:textColorPrimary">@color/concrete_900</item>
        <item name="android:textColorSecondary">@color/concrete_500</item>
        <item name="buttonBarPositiveButtonStyle">@style/ConcreteFactory.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/ConcreteFactory.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/ConcreteFactory.Dialog.Button</item>
    </style>

    <style name="ConcreteFactory.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/safety_amber_dark</item>
    </style>

    <style name="Widget.ConcreteFactory.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.ConcreteFactory.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CategoryTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">140dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/concrete_500</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="SettingsSwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:background">@color/concrete_200</item>
    </style>
</resources>
